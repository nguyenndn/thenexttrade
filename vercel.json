{
  "crons": [
    { "path": "/api/cron/send-scheduled-broadcasts", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/license-github-sync", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/cleanup-stale-ai-requests", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/generate-reports", "schedule": "5 0 * * *" },
    { "path": "/api/cron/expire-licenses", "schedule": "10 0 * * *" },
    { "path": "/api/cron/vip-policy", "schedule": "20 0 * * *" },
    { "path": "/api/cron/ib-snapshots", "schedule": "0 1 * * *" },
    { "path": "/api/cron/cleanup-security-logs", "schedule": "30 3 * * *" },
    { "path": "/api/cron/activation-reminders", "schedule": "0 6 * * *" },
    { "path": "/api/cron/sync-events", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/welcome-nudges", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/support-sync", "schedule": "0 10 * * 6" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
