generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @db.Uuid
  name                     String?
  email                    String?                   @unique
  emailVerified            DateTime?                 @db.Timestamptz(6)
  image                    String?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  checkInHistory           Json?
  lastCheckIn              DateTime?                 @db.Timestamptz(6)
  level                    Int                       @default(1)
  settings                 Json?
  streak                   Int                       @default(0)
  xp                       Int                       @default(0)
  showOnLeaderboard        Boolean                   @default(true)
  syncApiKey               String?                   @unique @map("sync_api_key") @db.VarChar(64)
  syncApiKeyCreatedAt      DateTime?                 @map("sync_api_key_created_at") @db.Timestamptz(6)
  broadcastsCreated        AdminBroadcast[]          @relation("BroadcastCreator")
  articles                 Article[]
  articleVotes             ArticleVote[]
  auditLogs                AuditLog[]                @relation("AdminAuditLogs")
  certificates             Certificate[]
  challengesReceived       Challenge[]               @relation("Challengee")
  challengesSent           Challenge[]               @relation("Challenger")
  comments                 Comment[]
  eaDownloads              EADownload[]
  EALicenses               EALicense[]
  feedbacks                Feedback[]
  journalEntries           JournalEntry[]
  media                    Media[]
  notifications            Notification[]
  profile                  Profile?
  badges                   UserBadge[]
  following                UserFollow[]              @relation("Followers")
  followers                UserFollow[]              @relation("Following")
  progress                 UserProgress[]
  quizAttempts             UserQuizAttempt[]
  sessions                 UserSession[]
  accountNotifications     AccountNotification[]
  analyticsEvents          AnalyticsEvent[]
  shortcuts                ContentShortcut[]
  copyTradingRegistrations CopyTradingRegistration[]
  eaCommands               EaCommand[]
  edgeEvents               EdgeEvent[]
  ibActivitySnapshots      IbActivitySnapshot[]
  ibLeads                  IbLead[]
  importHistory            ImportHistory[]
  proEntitlements          ProEntitlement[]
  strategies               Strategy[]
  tradingAccounts          TradingAccount[]
  tradingReports           TradingReport[]
  missionProgress          UserMissionProgress[]
  vipRequests              VipRequest[]
  traderSignals            TraderSignal[]
  coachActionPlans         CoachActionPlan[]

  @@index([createdAt])
  @@index([email])
  @@index([xp(sort: Desc)])
  @@index([streak(sort: Desc)])
}

model Profile {
  id                   String          @id @default(cuid())
  userId               String          @unique @db.Uuid
  username             String?         @unique
  bio                  String?
  role                 UserRole        @default(USER)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
  isPublicProfile      Boolean         @default(false) @map("is_public_profile")
  profileHeadline      String?         @map("profile_headline") @db.VarChar(160)
  showBadges           Boolean         @default(true) @map("show_badges")
  showPairStats        Boolean         @default(true) @map("show_pair_stats")
  showSessionStats     Boolean         @default(true) @map("show_session_stats")
  showTradeScore       Boolean         @default(false) @map("show_trade_score")
  mainTradingAccountId String?         @map("main_trading_account_id")
  telegramId           String?         @map("telegram_id") @db.VarChar(50)
  country              String?         @db.VarChar(100)
  mainTradingAccount   TradingAccount? @relation("ProfileMainAccount", fields: [mainTradingAccountId], references: [id])
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([username])
  @@index([country])
}

model Level {
  id           String        @id @default(cuid())
  title        String
  description  String?
  order        Int           @unique
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  accessLevel  String        @default("PUBLIC")
  certificates Certificate[]
  modules      Module[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  levelId     String
  order       Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  lessons     Lesson[]
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  quiz        Quiz?

  @@index([levelId])
}

model Lesson {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  content         String
  videoUrl        String?
  duration        Int?
  moduleId        String
  order           Int
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  status          String         @default("draft")
  metaDescription String?        @db.VarChar(160)
  rawContent      String?
  sourceUrls      String[]       @default([])
  tone            String?        @db.VarChar(30)
  comments        Comment[]
  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        UserProgress[]

  @@index([moduleId, order])
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime? @db.Timestamptz(6)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
}

model Article {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  thumbnail       String?
  status          ArticleStatus     @default(DRAFT)
  authorId        String            @db.Uuid
  categoryId      String
  views           Int               @default(0)
  isFeatured      Boolean           @default(false)
  publishedAt     DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  focusKeyword    String?
  metaDescription String?
  metaTitle       String?
  estimatedTime   Int?
  schemaType      ArticleSchemaType @default(ARTICLE)
  sourceUrls      String[]          @default([])
  tone            String?
  author          User              @relation(fields: [authorId], references: [id])
  category        Category          @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
  votes           ArticleVote[]
  comments        Comment[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([views])
  @@index([createdAt])
  @@index([status, createdAt], map: "article_status_created_idx")
  @@index([isFeatured, status, createdAt])
  @@index([status, views])
}

model ArticleVote {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  articleId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  articles    Article[]
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ContentShortcut {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  description String?
  content     String
  authorId    String   @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@map("content_shortcuts")
}

model JournalEntry {
  id               String          @id @default(cuid())
  userId           String          @db.Uuid
  symbol           String
  type             TradeType
  entryPrice       Float
  exitPrice        Float?
  stopLoss         Float?
  takeProfit       Float?
  lotSize          Float
  pnl              Float?
  status           TradeStatus     @default(OPEN)
  entryDate        DateTime        @db.Timestamptz(6)
  exitDate         DateTime?       @db.Timestamptz(6)
  notes            String?
  images           String[]
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  accountId        String?
  entryReason      String?
  exitReason       String?
  result           TradeResult?
  strategy         String?         @db.VarChar(100)
  confidenceLevel  Int?
  emotionAfter     String?         @db.VarChar(50)
  emotionBefore    String?         @db.VarChar(50)
  followedPlan     Boolean?
  notesPsychology  String?
  mistakes         Json?
  tradingSession   String?         @map("trading_session") @db.VarChar(20)
  commission       Float?          @default(0)
  externalHash     String?         @map("external_hash") @db.VarChar(64)
  externalTicket   String?         @map("external_ticket") @db.VarChar(100)
  importId         String?         @map("import_id") @db.Uuid
  swap             Float?          @default(0)
  syncSource       String          @default("MANUAL") @map("sync_source") @db.VarChar(20)
  syncedAt         DateTime?       @map("synced_at")
  shareDescription String?         @map("share_description")
  shareMode        String?         @default("full") @map("share_mode")
  tags             String[]        @default([])
  account          TradingAccount? @relation(fields: [accountId], references: [id])
  import           ImportHistory?  @relation(fields: [importId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalTicket])
  @@unique([userId, accountId, externalTicket])
  @@index([userId, status])
  @@index([entryDate])
  @@index([strategy])
  @@index([userId, exitDate])
  @@index([userId, accountId, exitDate])
  @@index([userId, symbol])
}

model Strategy {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  rules       String?
  color       String   @default("#6366F1") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("strategies")
}

model TradingAccount {
  id                       String                @id @default(cuid())
  userId                   String                @db.Uuid
  name                     String
  color                    String                @default("#00C888") @db.VarChar(20)
  broker                   String?
  server                   String?               @db.VarChar(100)
  accountNumber            String?               @map("account_number") @db.VarChar(50)
  balance                  Float                 @default(0)
  currency                 String                @default("USD")
  platform                 String?               @default("MetaTrader 4")
  isDefault                Boolean               @default(false)
  apiKey                   String?               @unique @map("api_key") @db.VarChar(64)
  apiKeyCreatedAt          DateTime              @default(now()) @map("api_key_created_at")
  status                   String                @default("PENDING") @db.VarChar(20)
  lastHeartbeat            DateTime?             @map("last_heartbeat")
  lastSync                 DateTime?             @map("last_sync")
  eaVersion                String?               @map("ea_version") @db.VarChar(20)
  totalTrades              Int                   @default(0) @map("total_trades")
  autoSync                 Boolean               @default(true) @map("auto_sync")
  syncOpenTrades           Boolean               @default(false) @map("sync_open_trades")
  equity                   Float?                @default(0)
  leverage                 String?               @db.VarChar(10)
  accountType              String                @default("PERSONAL") @map("account_type") @db.VarChar(30)
  tags                     String[]              @default([])
  notifyDisconnect         Boolean               @default(true) @map("notify_disconnect")
  disconnectThresholdHours Int                   @default(24) @map("disconnect_threshold_hours")
  apiKeyExpiresAt          DateTime?             @map("api_key_expires_at")
  ipWhitelist              String[]              @default([]) @map("ip_whitelist")
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(6)
  timezone                 String                @default("Etc/UTC") @map("timezone") @db.VarChar(50)
  useForLeaderboard        Boolean               @default(false) @map("use_for_leaderboard")
  cooldownAfterLosses      Int?                  @map("cooldown_after_losses")
  maxDailyLoss             Float?                @map("max_daily_loss")
  maxDailyTrades           Int?                  @map("max_daily_trades")
  maxRiskPercent           Float?                @map("max_risk_percent")
  appLastHeartbeat         DateTime?             @map("app_last_heartbeat") @db.Timestamptz(6)
  resyncRequest            String?               @map("resync_request") @db.VarChar(20)
  syncSource               String                @default("EA") @map("sync_source") @db.VarChar(20)
  journalEntries           JournalEntry[]
  mainForProfiles          Profile[]             @relation("ProfileMainAccount")
  notifications            AccountNotification[]
  commands                 EaCommand[]
  ibLeads                  IbLead[]              @relation("IbLeadAccount")
  importHistory            ImportHistory[]
  proEntitlement           ProEntitlement?
  syncHistory              SyncHistory[]
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipRequests              VipRequest[]          @relation("VipRequestAccount")

  @@index([userId])
  @@map("trading_accounts")
}

model AccountNotification {
  id               String         @id @default(uuid())
  tradingAccountId String         @map("trading_account_id")
  userId           String         @map("user_id") @db.Uuid
  type             String         @db.VarChar(30)
  title            String         @db.VarChar(200)
  message          String?
  isRead           Boolean        @default(false) @map("is_read")
  sentEmail        Boolean        @default(false) @map("sent_email")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("account_notifications")
}

model EaCommand {
  id               String         @id @default(uuid())
  tradingAccountId String         @map("trading_account_id")
  userId           String         @map("user_id") @db.Uuid
  type             String
  params           Json           @default("{}")
  status           String         @default("PENDING")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  result           Json?
  errorMessage     String?        @map("error_message")
  source           String         @default("WEB")
  ipAddress        String?        @map("ip_address")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tradingAccountId, status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ea_commands")
}

model ImportHistory {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  accountId     String?         @map("account_id")
  source        String          @db.VarChar(50)
  filename      String?         @db.VarChar(255)
  fileSize      Int?            @map("file_size")
  totalRows     Int             @default(0) @map("total_rows")
  importedCount Int             @default(0) @map("imported_count")
  skippedCount  Int             @default(0) @map("skipped_count")
  errorCount    Int             @default(0) @map("error_count")
  status        String          @default("PENDING") @db.VarChar(20)
  errorMessage  String?         @map("error_message")
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  trades        JournalEntry[]
  account       TradingAccount? @relation(fields: [accountId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("import_history")
}

model SyncHistory {
  id               String         @id @default(uuid()) @db.Uuid
  tradingAccountId String         @map("trading_account_id")
  tradesReceived   Int            @default(0) @map("trades_received")
  tradesImported   Int            @default(0) @map("trades_imported")
  tradesSkipped    Int            @default(0) @map("trades_skipped")
  eaVersion        String?        @map("ea_version") @db.VarChar(20)
  clientTime       DateTime?      @map("client_time")
  createdAt        DateTime       @default(now()) @map("created_at")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@index([tradingAccountId])
  @@map("sync_history")
}

model EconomicEvent {
  id        String      @id @default(cuid())
  title     String
  currency  String
  impact    ImpactLevel
  date      DateTime    @db.Timestamptz(6)
  forecast  String?
  previous  String?
  actual    String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([title, currency, date])
}

model Quiz {
  id          String            @id @default(cuid())
  title       String
  description String?
  moduleId    String?           @unique
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  questions   Question[]
  module      Module?           @relation(fields: [moduleId], references: [id])
  attempts    UserQuizAttempt[]
}

model Question {
  id        String   @id @default(cuid())
  quizId    String
  text      String
  order     Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  options   Option[]
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model UserQuizAttempt {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  quizId      String
  score       Int
  passed      Boolean  @default(false)
  completedAt DateTime @default(now()) @db.Timestamptz(6)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String   @db.Uuid
  levelId  String
  score    Int
  earnedAt DateTime @default(now()) @db.Timestamptz(6)
  level    Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String    @db.Uuid
  articleId String?
  lessonId  String?
  parentId  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  article   Article?  @relation(fields: [articleId], references: [id])
  lesson    Lesson?   @relation(fields: [lessonId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
  @@index([createdAt])
  @@index([lessonId])
  @@index([parentId])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  context   String?
  severity  String   @default("ERROR")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String
  type         String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  caption      String?
  thumbnailUrl String?
  userId       String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  icon        String
  xpReward    Int         @default(0)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  category    String      @default("milestone")
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @db.Uuid
  badgeId  String
  earnedAt DateTime @default(now()) @db.Timestamptz(6)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model EABroker {
  id                       String   @id @default(uuid())
  name                     String
  slug                     String   @unique
  logo                     String
  affiliateUrl             String?
  color                    String   @default("#00C888")
  isActive                 Boolean  @default(true)
  order                    Int      @default(0)
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)
  ibCode                   String?
  commissionCurrency       String?  @default("USD") @map("commission_currency") @db.VarChar(10)
  commissionPerLot         Float?   @map("commission_per_lot")
  isVipEligible            Boolean  @default(true) @map("is_vip_eligible")
  requiresCountry          Boolean  @default(false) @map("requires_country")
  requiresScreenshot       Boolean  @default(false) @map("requires_screenshot")
  verificationInstructions String?  @map("verification_instructions")

  @@index([isActive])
  @@map("ea_brokers")
}

model EALicense {
  id            String        @id @default(uuid())
  userId        String        @db.Uuid
  accountNumber String
  status        AccountStatus @default(PENDING)
  startDate     DateTime?     @db.Timestamptz(6)
  expiryDate    DateTime?     @db.Timestamptz(6)
  note          String?
  approvedBy    String?
  approvedAt    DateTime?     @db.Timestamptz(6)
  rejectedBy    String?
  rejectedAt    DateTime?     @db.Timestamptz(6)
  rejectReason  String?
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?     @db.Timestamptz(6)
