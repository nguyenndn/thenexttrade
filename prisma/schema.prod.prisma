  order        Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @db.Timestamptz(6)

  @@index([isActive])
}

model ea_commands {
  id                 String           @id
  trading_account_id String
  user_id            String           @db.Uuid
  type               String
  params             Json             @default("{}")
  status             String           @default("PENDING")
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  started_at         DateTime?        @db.Timestamptz(6)
  completed_at       DateTime?        @db.Timestamptz(6)
  expires_at         DateTime?        @db.Timestamptz(6)
  result             Json?
  error_message      String?
  source             String           @default("WEB")
  ip_address         String?
  trading_accounts   trading_accounts @relation(fields: [trading_account_id], references: [id], onDelete: Cascade)
  User               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([trading_account_id, status, created_at])
  @@index([user_id, created_at(sort: Desc)])
}

model import_history {
  id               String            @id @db.Uuid
  user_id          String            @db.Uuid
  account_id       String?
  source           String            @db.VarChar(50)
  filename         String?           @db.VarChar(255)
  file_size        Int?
  total_rows       Int               @default(0)
  imported_count   Int               @default(0)
  skipped_count    Int               @default(0)
  error_count      Int               @default(0)
  status           String            @default("PENDING") @db.VarChar(20)
  error_message    String?
  started_at       DateTime          @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  JournalEntry     JournalEntry[]
  trading_accounts trading_accounts? @relation(fields: [account_id], references: [id])
  User             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model page_views {
  id          String   @id
  pathname    String
  referrer    String?
  country     String?  @db.VarChar(2)
  city        String?
  region      String?
  device      String?  @db.VarChar(10)
  browser     String?  @db.VarChar(30)
  os          String?  @db.VarChar(30)
  sessionId   String   @db.VarChar(64)
  utmSource   String?  @db.VarChar(100)
  utmMedium   String?  @db.VarChar(100)
  utmCampaign String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([country])
  @@index([createdAt])
  @@index([pathname])
  @@index([sessionId])
  @@index([utmCampaign])
}

model partners {
  id                         Int                          @id @default(autoincrement())
  partner_code               String                       @unique
  partner_name               String
  api_key_hash               String
  webhook_url                String?
  allowed_ips                String?
  allowed_domains            String?
  status                     String                       @default("ACTIVE")
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  copy_trading_registrations copy_trading_registrations[]
}

model security_logs {
  id        String   @id
  type      String   @db.VarChar(30)
  ip        String   @db.VarChar(45)
  userAgent String?
  path      String?  @db.VarChar(500)
  detail    String?
  userId    String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([ip])
  @@index([type])
}

model strategies {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  rules       String?
  color       String   @default("#6366F1") @db.VarChar(7)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @db.Timestamptz(6)
  User        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
  @@index([user_id])
}

model sync_history {
  id                 String           @id @db.Uuid
  trading_account_id String
  trades_received    Int              @default(0)
  trades_imported    Int              @default(0)
  trades_skipped     Int              @default(0)
  ea_version         String?          @db.VarChar(20)
  client_time        DateTime?
  created_at         DateTime         @default(now())
  trading_accounts   trading_accounts @relation(fields: [trading_account_id], references: [id], onDelete: Cascade)

  @@index([trading_account_id])
}

model trading_accounts {
  id                         String                  @id
  userId                     String                  @db.Uuid
  name                       String
  color                      String                  @default("#00C888") @db.VarChar(20)
  broker                     String?
  server                     String?                 @db.VarChar(100)
  account_number             String?                 @db.VarChar(50)
  balance                    Float                   @default(0)
  currency                   String                  @default("USD")
  platform                   String?                 @default("MetaTrader 4")
  isDefault                  Boolean                 @default(false)
  api_key                    String?                 @unique @db.VarChar(64)
  api_key_created_at         DateTime                @default(now())
  status                     String                  @default("PENDING") @db.VarChar(20)
  last_heartbeat             DateTime?
  last_sync                  DateTime?
  ea_version                 String?                 @db.VarChar(20)
  total_trades               Int                     @default(0)
  auto_sync                  Boolean                 @default(true)
  sync_open_trades           Boolean                 @default(false)
  timezone                   String                  @default("Etc/UTC") @db.VarChar(50)
  equity                     Float?                  @default(0)
  leverage                   String?                 @db.VarChar(10)
  account_type               String                  @default("PERSONAL") @db.VarChar(30)
  tags                       String[]                @default([])
  notify_disconnect          Boolean                 @default(true)
  disconnect_threshold_hours Int                     @default(24)
  api_key_expires_at         DateTime?
  ip_whitelist               String[]                @default([])
  createdAt                  DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                @db.Timestamptz(6)
  use_for_leaderboard        Boolean                 @default(false)
  max_daily_loss             Float?
  max_daily_trades           Int?
  max_risk_percent           Float?
  cooldown_after_losses      Int?
  app_last_heartbeat         DateTime?               @db.Timestamptz(6)
  resync_request             String?                 @db.VarChar(20)
  sync_source                String                  @default("EA") @db.VarChar(20)
  JournalEntry               JournalEntry[]
  account_notifications      account_notifications[]
  ea_commands                ea_commands[]
  import_history             import_history[]
  sync_history               sync_history[]
  User                       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model trading_reports {
  id             String     @id
  userId         String     @db.Uuid
  type           ReportType
  periodStart    DateTime   @db.Timestamptz(6)
  periodEnd      DateTime   @db.Timestamptz(6)
  periodLabel    String
  totalTrades    Int        @default(0)
  winCount       Int        @default(0)
  lossCount      Int        @default(0)
  winRate        Float      @default(0)
  netPnL         Float      @default(0)
  grossProfit    Float      @default(0)
  grossLoss      Float      @default(0)
  profitFactor   Float      @default(0)
  avgWin         Float      @default(0)
  avgLoss        Float      @default(0)
  largestWin     Float      @default(0)
  largestLoss    Float      @default(0)
  prevPnL        Float?
  prevWinRate    Float?
  prevTrades     Int?
  bySymbol       Json?
  byStrategy     Json?
  bySession      Json?
  byDay          Json?
  avgConfidence  Float?
  planCompliance Float?
  topEmotions    Json?
  topMistakes    Json?
  bestTrades     Json?
  worstTrades    Json?
  emailSent      Boolean    @default(false)
  emailSentAt    DateTime?  @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  User           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart])
  @@index([createdAt])
  @@index([userId, type])
}

model vip_requests {
  id            String           @id
  userId        String           @db.Uuid
  broker        String           @db.VarChar(50)
  accountNumber String           @db.VarChar(50)
  balance       String           @db.VarChar(50)
  fullName      String?          @db.VarChar(100)
  email         String
  country       String?          @db.VarChar(100)
  telegramId    String           @db.VarChar(100)
  screenshotUrl String?
  status        VipRequestStatus @default(PENDING)
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?        @db.Timestamptz(6)
  rejectReason  String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @db.Timestamptz(6)
  User          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

