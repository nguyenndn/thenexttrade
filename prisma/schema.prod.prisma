  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  User       User     @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
  @@index([targetType])
}

model Badge {
