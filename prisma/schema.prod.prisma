model AdminBroadcast {
  id              String               @id
  type            NotificationType
  title           String
  message         String
  link            String?
  icon            String?
  priority        NotificationPriority @default(NORMAL)
  targetAll       Boolean              @default(true)
  targetRoles     String[]             @default([])
  targetUserIds   String[]             @default([])
  scheduledAt     DateTime?            @db.Timestamptz(6)
  sentAt          DateTime?            @db.Timestamptz(6)
  totalRecipients Int                  @default(0)
  readCount       Int                  @default(0)
  createdBy       String               @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @db.Timestamptz(6)
  User            User                 @relation(fields: [createdBy], references: [id])
  Notification    Notification[]

  @@index([createdAt])
  @@index([sentAt])
}

model Article {
  id              String            @id
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  thumbnail       String?
  status          ArticleStatus     @default(DRAFT)
  authorId        String            @db.Uuid
  categoryId      String
  views           Int               @default(0)
  isFeatured      Boolean           @default(false)
  publishedAt     DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @db.Timestamptz(6)
  focusKeyword    String?
  metaDescription String?
  metaTitle       String?
  estimatedTime   Int?
  schemaType      ArticleSchemaType @default(ARTICLE)
  tone            String?
  sourceUrls      String[]          @default([])
  User            User              @relation(fields: [authorId], references: [id])
  Category        Category          @relation(fields: [categoryId], references: [id])
  ArticleTag      ArticleTag[]
  ArticleVote     ArticleVote[]
  Comment         Comment[]

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([isFeatured, status, createdAt])
  @@index([status])
  @@index([status, views])
  @@index([views])
  @@index([status, createdAt], map: "article_status_created_idx")
}

model ArticleTag {
  articleId String
  tagId     String
  Article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  Tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleVote {
  id        String   @id
  userId    String   @db.Uuid
  articleId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  Article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

model AuditLog {
  id         String   @id
