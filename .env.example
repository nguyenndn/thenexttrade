# Example Environment Variables for TheNextTrade
# Copy this file to .env.local and fill in actual values
# NEVER commit real secrets to git — use Vercel Dashboard for production

# Database (Supabase)
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL
NEXT_PUBLIC_APP_URL="https://thenexttrade.vercel.app"

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_ANALYTICS_ENABLED="true"

# Redis (Upstash REST API)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Cloudflare R2 (Object Storage for Images)
R2_ENDPOINT=""
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
ASSET_PUBLIC_BASE_URL=""

# Email (Resend SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key"
SMTP_SECURE="false"
SMTP_FROM_EMAIL="onboarding@resend.dev"
SMTP_FROM_NAME="The Next Trade"

# AI Services (Optional)
GEMINI_API_KEY="your-gemini-api-key"
# GITHUB_TOKEN="ghp_your_github_token"

# Vercel Cron (auto-injected by Vercel, or set manually)
# CRON_SECRET="your-random-secret"

# Node Environment
NODE_ENV="development"

# Email Lab Settings
ENABLE_EMAIL_TEST_PAGE="false"
EMAIL_TEST_TO="admin@example.com"
EMAIL_TEST_ALLOW_CUSTOM_TO="false"

# TraderWaves Gap Feature Flags
NEXT_PUBLIC_ENABLE_SYNC_HEALTH_CENTER="true"
NEXT_PUBLIC_ENABLE_PRIVACY_PRESETS="true"
NEXT_PUBLIC_ENABLE_RULEBOOK_GOALS="true"
NEXT_PUBLIC_ENABLE_TRADE_PLANS="true"
