# Environment template for TheNextTrade
# ---------------------------------------------------------------------------
# Copy to .env.local for development. Production values live in Coolify
# (application "thenexttrade" → Environment Variables), NOT here.
# NEVER commit real secrets: this repository is public.
#
# Full inventory, when each key is required, where its value comes from and
# how to rebuild production from scratch: docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# ── Database (Supabase / Postgres) ──────────────────────────────────────────
# Required. Runtime uses the pooled URL (6543 + pgbouncer); migrations use DIRECT_URL.
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"
# Optional: only used by prisma/db.js helper scripts.
# SUPABASE_DATABASE_URL=""

# ── Supabase auth ───────────────────────────────────────────────────────────
# Required.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── URLs ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is baked at build time — changing it requires a redeploy.
# Development: http://localhost:3500 | Production: https://thenexttrade.app
NEXT_PUBLIC_APP_URL="http://localhost:3500"
NEXT_PUBLIC_SYNC_SERVER_URL="https://thenexttrade.app"
# Optional alias read by src/lib/url.ts when NEXT_PUBLIC_APP_URL is empty.
APP_URL=""

# ── Encryption ──────────────────────────────────────────────────────────────
# Required in production.
# ENCRYPTION_SECRET encrypts AI-provider credentials (>= 32 bytes).
# Generate once and keep the same value on every instance reading the same DB.
ENCRYPTION_SECRET=""
# MT5_IMPORT_ENCRYPTION_KEY (AES-256-GCM) protects stored MT5 investor passwords.
# IRREPLACEABLE: losing/changing it makes every stored credential unreadable.
# Generate: openssl rand -base64 32
MT5_IMPORT_ENCRYPTION_KEY=""
# Temporary AI-credential migration only; remove after re-encrypting.
# AI_LEGACY_ENCRYPTION_SECRET=""
# Optional fallback for src/lib/crypto.ts when MT5_IMPORT_ENCRYPTION_KEY is unset.
# NEXTAUTH_SECRET=""

# ── Internal secrets ────────────────────────────────────────────────────────
# Required in production. Generate each with: openssl rand -base64 32
CRON_SECRET=""
INTERNAL_SECURITY_SECRET=""
ANALYTICS_SECRET=""
# Bearer for /api/worker/jobs/*.
WORKER_API_KEY=""
# MT5_WORKER_KEY=""               # legacy alias, read only when WORKER_API_KEY is unset

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Local/staging only — leave unset (false) in production.
DISABLE_TURNSTILE="false"
NEXT_PUBLIC_DISABLE_TURNSTILE="false"

# ── Cloudflare R2 (object storage) ──────────────────────────────────────────
R2_ENDPOINT=""
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public base URL for assets. NEXT_PUBLIC_R2_PUBLIC_URL is baked at build time.
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
ASSET_PUBLIC_BASE_URL=""

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Template defaults are for Resend; production currently uses Brevo
# (smtp-relay.brevo.com, port 587). Any SMTP relay works.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM_EMAIL="onboarding@resend.dev"
SMTP_FROM_NAME="The Next Trade"
# Fallbacks read by the email service when the SMTP_* names are absent.
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM=""

# ── Email testing (development only) ────────────────────────────────────────
ENABLE_EMAIL_TEST_PAGE="false"
EMAIL_TEST_TO="admin@example.com"
EMAIL_TEST_ALLOW_CUSTOM_TO="false"
EMAIL_TEST_ALLOW_PRODUCTION="false"
MAILTRAP_ACCOUNT_ID=""
MAILTRAP_API_TOKEN=""
MAILTRAP_INBOX_ID=""

# ── AI / search ─────────────────────────────────────────────────────────────
# Provider keys are stored encrypted in the DB (AI Gateway); these power
# tool-using features.
SERPER_API_KEY=""
FIRECRAWL_API_KEY=""
ECONOMIC_CALENDAR_PROVIDER_URL=""

# ── GitHub EA license backup ────────────────────────────────────────────────
# Requires a PAT with repo scope on the target repository.
GITHUB_TOKEN=""
GITHUB_LICENSE_REPO="nguyenndn/ea-accounts"
GITHUB_LICENSE_PATH="accounts.csv"
GITHUB_LICENSE_BRANCH="main"

# ── MT5 Cloud Sync ──────────────────────────────────────────────────────────
# Defaults are safe; only override when there is a measured reason.
MT5_SYNC_CONCURRENCY="2"
MT5_TRADE_CACHE_DIR=""          # default: <repo>/mt5-cloud-sync/trade-cache (image: /app/mt5-cloud-sync/trade-cache)
MT5_TRADE_CACHE_MAX_MB="1024"
MT5_HISTORY_TIMEOUT_MS="540000"
MT5_PUMP_TIMEOUT_MS="600000"
MT5_JAVA_HEAP="-Xmx768m"
MT5_JAVA_PATH=""                # default: java from PATH (needs OpenJDK 17+)
MT5_APK_PATH=""                 # default: bundled mt5-cloud-sync/bin/metatrader5.apk

# ── Redis / rate limiting ───────────────────────────────────────────────────
REDIS_URL="redis://default:password@localhost:6379/0"

# ── Public feature flags ────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_SYNC_HEALTH_CENTER="true"
NEXT_PUBLIC_ENABLE_PRIVACY_PRESETS="true"
NEXT_PUBLIC_ENABLE_RULEBOOK_GOALS="true"
NEXT_PUBLIC_ENABLE_TRADE_PLANS="true"

# ── Server feature flags ────────────────────────────────────────────────────
FEATURE_GROWTH_ORCHESTRATOR="false"
FEATURE_ADAPTIVE_DASHBOARD="false"
FEATURE_ADMIN_IMPROVEMENT_FUNNEL="false"
FEATURE_IMPROVEMENT_EXPERIMENTS="false"
VIP_POLICY_ENABLED="false"

# ── SEO / marketing ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_TELEGRAM_URL=""
VIP_TELEGRAM_URL=""
INDEXNOW_KEY=""

# ── Contact / support ───────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
SUPPORT_EMAIL="support@example.com"
USER_QA_EMAIL=""

# ── Security alerting → Telegram (optional; no-op when unset) ───────────────
# Create a bot with @BotFather, message it, then read the chat id from
# https://api.telegram.org/bot<token>/getUpdates
SECURITY_ALERT_TELEGRAM_BOT_TOKEN=""
SECURITY_ALERT_TELEGRAM_CHAT_ID=""

# ── Runtime / tooling ───────────────────────────────────────────────────────
# PORT, NEXT_RUNTIME and VERCEL are injected by the platform; do not set them.
NODE_ENV="development"
# JAVA_HOME=""                  # optional, MT5_JAVA_PATH takes precedence
# ANALYZE="false"               # bundle analyser
